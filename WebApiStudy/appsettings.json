{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JWT": {
    "ValidAudience": "http://localhost:7066", // Define a audiência da chave, ou seja, quem irá poder usar o token, a quem ele se destina.
    "ValidIssuer": "https://localhost:5001", // Define o emissor da chave, identifica quem gerou e assinou o token.
    "SecretKey": "MarcoReus@ChaveSecret4Priv4Da", //Define a chave secreta que nunca pode ser compartilhada.
    "TokenValidityInMinutes": 30, //Validade do token.
    "RefreshTokenValidityInMinutes": 60 //Validade do refresh token.
  }
}
